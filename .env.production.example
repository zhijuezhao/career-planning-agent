# ============================================
# Production Environment Configuration
# ============================================
# Copy this file to .env and fill in real values
# NEVER commit .env to version control!

# Application (REQUIRED)
APP_NAME=career-planning-agent
APP_ENV=production
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8001

# Database (REQUIRED - use strong password!)
POSTGRES_DB=career_planning
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD_32_CHARS_MIN

# Redis (REQUIRED)
REDIS_PASSWORD=CHANGE_ME_TO_A_STRONG_REDIS_PASSWORD

# JWT (REQUIRED - generate with: openssl rand -hex 32)
JWT_SECRET_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM - DeepSeek (REQUIRED for primary LLM)
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# LLM - Qwen (REQUIRED for fallback)
QWEN_API_KEY=sk-your-qwen-api-key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# LLM - LongCat (OPTIONAL)
LONGCAT_API_KEY=
LONGCAT_BASE_URL=https://api.longcat.chat/openai
LONGCAT_MODEL=LongCat-2.0

# Embedding - SiliconFlow (REQUIRED)
SILICONFLOW_API_KEY=sk-your-siliconflow-api-key
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B

# LLM Gateway
LLM_DEFAULT_MODEL=deepseek
LLM_FALLBACK_ORDER=deepseek,qwen
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096
LLM_REQUEST_TIMEOUT=60

# LangSmith (OPTIONAL - set to false in production if not used)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=career-planning-agent

# File Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# Resume Parsing
RESUME_MAX_TEXT_CHARS=15000
RESUME_LLM_MODEL=

# Web Search - Tavily (OPTIONAL)
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com

# CORS (REQUIRED - set to your domain in production)
CORS_ORIGINS=https://yourdomain.com,https://admin.yourdomain.com

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log

# Security
ALLOWED_HOSTS=yourdomain.com,admin.yourdomain.com
