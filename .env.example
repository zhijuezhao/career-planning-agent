# ============================================
# 本地开发环境配置模板
# ============================================
# 用法：cp .env.example .env 然后按需填写
# ⚠ .env 已被 .gitignore 忽略；**绝不要**把真实密钥写进本文件（本文件是入库的）
#
# 说明（2026-10-09 安全审计 M-5）：本模板此前与 `backend/app/config.py` 漂移
# —— 缺 EMBEDDING_*/DASHSCOPE_API_KEY/TAVILY_*/CORS_ORIGINS 等键，照它配出来的栈
# 跑不出 embedding。现在按 Settings 字段全量对齐；多写的键会让后端**直接启动失败**
# （pydantic-settings 的 extra="forbid"），所以新增变量务必同时加进 config.py。

# Application
APP_NAME=career-planning-agent
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8001

# Database
# POSTGRES_* 由 docker-compose 消费；DATABASE_URL 由应用消费
POSTGRES_DB=career_planning
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/career_planning
DATABASE_ECHO=false

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# JWT（生产必须换成强随机值：openssl rand -hex 32）
# 注意：APP_ENV=production 且此处仍是占位符/短于 32 位时，后端会**拒绝启动**
JWT_SECRET_KEY=change-me-to-a-random-secret-key-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM - DeepSeek（主力）
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# LLM - Qwen（回退）
QWEN_API_KEY=sk-your-qwen-api-key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# LLM - LongCat（可选）
LONGCAT_API_KEY=
LONGCAT_BASE_URL=https://api.longcat.chat/openai
LONGCAT_MODEL=LongCat-2.0

# Embedding - 通用 provider（优先级最高；数据库列固定 vector(1024)）
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=

# Embedding - 阿里云百炼 / DashScope（与 EMBEDDING_* 二选一）
DASHSCOPE_API_KEY=
QWEN_EMBEDDING_MODEL=

# Embedding - SiliconFlow（兼容回退）
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B

# LLM Gateway
LLM_DEFAULT_MODEL=deepseek
LLM_FALLBACK_ORDER=deepseek,qwen,longcat
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=4096
LLM_REQUEST_TIMEOUT=60

# LangSmith（可选）
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=career-planning-agent

# File storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10

# Resume parsing
RESUME_MAX_TEXT_CHARS=15000
RESUME_LLM_MODEL=

# Web search - Tavily（可选）
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com

# CORS（可选）：追加在本地开发来源之后
CORS_ORIGINS=
# ⚠ 当前版本未接线 TrustedHostMiddleware，填了不生效
ALLOWED_HOSTS=
# 留空 = 开发 DEBUG / 生产 INFO
LOG_LEVEL=
LOG_FILE=./logs/app.log
