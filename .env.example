# Application
APP_NAME=career-planning-agent
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8001

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/career_planning
DATABASE_ECHO=false

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=change-me-to-a-random-secret-key-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM - DeepSeek
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# LLM - Qwen (fallback)
QWEN_API_KEY=sk-your-qwen-api-key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# Embedding - SiliconFlow
SILICONFLOW_API_KEY=sk-your-siliconflow-api-key
SILICONFLOW_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B

# LangSmith
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your-langsmith-api-key
LANGCHAIN_PROJECT=career-planning-agent

# File storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10
